#!/usr/bin/env bash
# treehouse-tmux - glue between git worktrees, treehouse pool status, and tmux sessions
# Backs the "treehouse" television channel (cable/treehouse.toml).

set -euo pipefail

show_help() {
  cat << 'EOF'
treehouse-tmux - glue between git worktrees, treehouse pool status, and tmux sessions

Usage:
  treehouse-tmux list
      Print one TSV row per git worktree of the current repo:
        path <TAB> pool-name <TAB> pool-status <TAB> display
      Worktrees outside the treehouse pool (e.g. the main checkout) get "-"
      for pool-name and pool-status. Silent, exit 0, if not inside a git repo.

  treehouse-tmux release <path>
      Kill the tmux session for <path> (see `nic -N`) and return the
      worktree to the pool with `treehouse return --force`. Refuses if
      <path> is not a pool worktree.

  treehouse-tmux new
      Lease a fresh worktree from the pool and open a tmux session in it.

  treehouse-tmux preview <path>
      Print a human-readable summary of <path>: pool status, lease, tmux
      session state, HEAD, ahead/behind the base branch, dirty files,
      diffstat and recent log. Colourised unless NO_COLOR is set.
EOF
}

pool_status_json() {
  treehouse status --json 2>/dev/null || echo '[]'
}

cmd_list() {
  git rev-parse --is-inside-work-tree > /dev/null 2>&1 || exit 0

  local pool_json
  pool_json="$(pool_status_json)"

  local paths=()
  while IFS= read -r line; do
    paths+=("${line#worktree }")
  done < <(git worktree list --porcelain | grep '^worktree ')

  local names=() statuses=() name_width=1 status_width=1
  local path name status
  for path in "${paths[@]}"; do
    name="$(jq -r --arg p "$path" 'first(.[] | select(.path == $p) | .name) // "-"' <<< "$pool_json")"
    status="$(jq -r --arg p "$path" 'first(.[] | select(.path == $p) | .status) // "-"' <<< "$pool_json")"
    names+=("$name")
    statuses+=("$status")
    (( ${#name} > name_width )) && name_width=${#name}
    (( ${#status} > status_width )) && status_width=${#status}
  done

  local i shown
  for i in "${!paths[@]}"; do
    # Avoid `${var/#$HOME/~}`: bash tilde-expands the replacement word
    # before substituting, which turns `~` back into $HOME and no-ops.
    if [[ "${paths[$i]}" == "$HOME"* ]]; then
      shown="~${paths[$i]#"$HOME"}"
    else
      shown="${paths[$i]}"
    fi
    printf '%s\t%s\t%s\t%-*s  %-*s  %s\n' \
      "${paths[$i]}" "${names[$i]}" "${statuses[$i]}" \
      "$name_width" "${names[$i]}" "$status_width" "${statuses[$i]}" "$shown"
  done
}

cmd_release() {
  local path="${1:?usage: treehouse-tmux release <path>}"
  path="$(cd "$path" && pwd -P)"

  local name
  name="$(jq -r --arg p "$path" 'first(.[] | select(.path == $p) | .name) // empty' <<< "$(pool_status_json)")"
  if [[ -z "$name" ]]; then
    echo "treehouse-tmux: '$path' is not a treehouse pool worktree, refusing to return it" >&2
    exit 1
  fi

  local session
  session="$(nic -N "$path")"
  tmux kill-session -t "$session" 2>/dev/null || true

  treehouse return --force "$path"
}

cmd_new() {
  local path
  path="$(treehouse get --lease)"
  nic "$path"
}

# Field-width used for the two-column key/value layout, e.g. "  lease   ".
readonly PREVIEW_LABEL_WIDTH=7

if [[ -z "${NO_COLOR:-}" ]]; then
  c_reset=$'\e[0m'
  c_bold=$'\e[1m'
  c_dim=$'\e[2m'
  c_green=$'\e[32m'
  c_yellow=$'\e[33m'
  c_red=$'\e[31m'
  git_color_opts=(-c color.ui=always)
else
  c_reset=""
  c_bold=""
  c_dim=""
  c_green=""
  c_yellow=""
  c_red=""
  git_color_opts=(-c color.ui=never)
fi

status_color() {
  case "$1" in
    available) echo "$c_green" ;;
    leased) echo "$c_yellow" ;;
    inUse | dirty) echo "$c_red" ;;
    *) echo "$c_dim" ;;
  esac
}

cmd_preview() {
  local raw="${1:?usage: treehouse-tmux preview <path>}"
  local path
  if ! path="$(cd "$raw" 2> /dev/null && pwd -P)"; then
    echo "treehouse-tmux: '$raw' does not exist" >&2
    return 0
  fi

  local entry name status lease_holder leased_at procs
  entry="$(jq -c --arg p "$path" 'first(.[] | select(.path == $p)) // {}' <<< "$(pool_status_json)")"
  name="$(jq -r '.name // "-"' <<< "$entry")"
  status="$(jq -r '.status // "-"' <<< "$entry")"
  lease_holder="$(jq -r '.lease_holder // empty' <<< "$entry")"
  leased_at="$(jq -r '.leased_at // empty' <<< "$entry")"
  procs="$(jq -r '(.processes // []) | map(.name) | unique | join(", ")' <<< "$entry")"
  [[ -z "$procs" ]] && procs="none"

  local lease_field="—"
  if [[ -n "$leased_at" ]]; then
    lease_field="since ${leased_at:11:5}"
    [[ -n "$lease_holder" ]] && lease_field="$lease_holder $lease_field"
  fi

  local session tmux_state
  session="$(nic -N "$path" 2> /dev/null || echo '?')"
  if tmux has-session -t "$session" 2> /dev/null; then
    tmux_state="live"
  else
    tmux_state="no session"
  fi

  local head_sha branch head_field
  head_sha="$(git -C "$path" rev-parse --short HEAD 2> /dev/null || true)"
  branch="$(git -C "$path" symbolic-ref -q --short HEAD 2> /dev/null || true)"
  if [[ -n "$branch" ]]; then
    head_field="$branch @ ${head_sha:-?}"
  elif [[ -n "$head_sha" ]]; then
    head_field="detached at $head_sha"
  else
    head_field="-"
  fi

  local base_branch base_field="-"
  base_branch="$(treehouse status 2> /dev/null | awk 'NR==1{print $2}')"
  [[ -z "$base_branch" ]] && base_branch="origin/HEAD"
  if [[ -n "$head_sha" ]]; then
    local behind ahead
    read -r behind ahead <<< "$(git -C "$path" rev-list --left-right --count "$base_branch...HEAD" 2> /dev/null || echo "0 0")"
    base_field="$base_branch · ${ahead:-0} ahead, ${behind:-0} behind"
  fi

  local dirty_count=0 dirty_field="-"
  if [[ -n "$head_sha" ]]; then
    dirty_count="$(git -C "$path" status --porcelain 2> /dev/null | wc -l | tr -d ' ')"
    dirty_field="$dirty_count files"
  fi

  echo "${c_bold}╭─ ${name} · $(status_color "$status")${status}${c_reset}${c_bold} ──────────────────────────────${c_reset}"
  printf '  %-*s %s\n' "$PREVIEW_LABEL_WIDTH" "lease" "$lease_field"
  printf '  %-*s %s\n' "$PREVIEW_LABEL_WIDTH" "procs" "$procs"
  printf '  %-*s %s (%s)\n' "$PREVIEW_LABEL_WIDTH" "tmux" "$session" "$tmux_state"
  echo
  printf '  %-*s %s\n' "$PREVIEW_LABEL_WIDTH" "HEAD" "$head_field"
  printf '  %-*s %s\n' "$PREVIEW_LABEL_WIDTH" "base" "$base_field"
  printf '  %-*s %s\n' "$PREVIEW_LABEL_WIDTH" "dirty" "$dirty_field"

  if [[ -n "$head_sha" ]]; then
    local status_short diffstat_out log_out
    # `|| true` guards against `set -o pipefail` turning head's early pipe
    # close (SIGPIPE to git, once there are more than 10 changed files)
    # into a non-zero exit that `set -e` would abort the script on.
    status_short="$(git "${git_color_opts[@]}" -C "$path" status --short 2> /dev/null | head -10 || true)"
    diffstat_out="$(git "${git_color_opts[@]}" -C "$path" diff --stat "$base_branch...HEAD" 2> /dev/null || true)"
    log_out="$(git "${git_color_opts[@]}" -C "$path" log --oneline -5 2> /dev/null || true)"

    # Only a blank line + section when there's something to show, so a
    # worktree with nothing to report (clean, no unique commits) doesn't
    # trail off into a stack of empty lines.
    [[ -n "$status_short" ]] && { echo; echo "$status_short"; }
    [[ -n "$diffstat_out" ]] && { echo; echo "$diffstat_out"; }
    [[ -n "$log_out" ]] && { echo; echo "$log_out"; }
  fi
}

case "${1:-}" in
  list)
    cmd_list
    ;;
  release)
    shift
    cmd_release "$@"
    ;;
  new)
    cmd_new
    ;;
  preview)
    shift
    cmd_preview "$@"
    ;;
  -h | --help | help | "")
    show_help
    ;;
  *)
    echo "treehouse-tmux: unknown command '$1'" >&2
    show_help >&2
    exit 1
    ;;
esac
